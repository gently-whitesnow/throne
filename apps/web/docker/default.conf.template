# nginx-шаблон веб-контейнера. Обрабатывается envsubst на старте образа
# (см. Dockerfile: NGINX_ENVSUBST_FILTER=THRONE_), поэтому подставляется только
# ${THRONE_API_UPSTREAM}; собственные переменные nginx ($uri, $host, ...) целы.
#
# Upstream выбирается режимом запуска:
#   * контейнерный (docker-compose.yml --profile full) — api:5008 (соседний сервис);
#   * host-backend (docker-compose.host.yml) — host.docker.internal:5008 (нативный
#     API на хосте, см. ADR-0027).
# Браузер всегда ходит на тот же origin (web:8080) → CORS не нужен.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA на корне: try_files отдаёт index.html для любых неподходящих путей
    # (роутер throne сам разберётся). В prod за Caddy /api/* и /login и др. сюда
    # не доходят — Caddy их перехватывает выше. /api/ proxy ниже работает только
    # для локального запуска без reverse-proxy.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://${THRONE_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Встроенный терминал (/api/v1/intents/{id}/terminal/ws) — bidirectional
        # WebSocket; без upgrade-проброса nginx закроет handshake.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }
}
