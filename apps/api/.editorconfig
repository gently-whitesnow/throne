root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{json,yml,yaml,md,sh}]
indent_size = 2

[*.cs]
# Code style
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning

# Code metrics analyzers (thresholds in apps/api/CodeMetricsConfig.txt).
# With TreatWarningsAsErrors=true these become blocking on backend-build.
dotnet_diagnostic.CA1501.severity = warning
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1505.severity = warning
dotnet_diagnostic.CA1506.severity = warning

# Nullability
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning

# Naming - instance private fields _camelCase (constants stay PascalCase)
dotnet_naming_rule.private_instance_fields_underscore.severity = warning
dotnet_naming_rule.private_instance_fields_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_instance_fields.required_modifiers =
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.private_const_fields_pascal.severity = suggestion
dotnet_naming_rule.private_const_fields_pascal.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_pascal.style = pascal_case_style
dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_static_readonly_pascal.severity = suggestion
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_case_style
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static,readonly

# Tests use snake_case method names (idiomatic xUnit) — disable CA1707
[**/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# ADR-0023: MCP tool parameter names ship as part of the MCP wire-format
# (snake_case: intent_id, from_id, target_kind, …). This directory is an API
# boundary, not normal C# code, so CA1707 is structurally illegal here.
[src/Throne.Api/Mcp/Tools/**.cs]
dotnet_diagnostic.CA1707.severity = none

# intent:4b43b94c4a194a30b8ddb99c67643d7f: CA1502(Type) суммирует cyclomatic по всем
# членам типа. NSwag-generated REST-контроллер декларирует по одному abstract overrides
# на route; с 10+ routes type-level sum не помещается под 10 даже при `=> _x.Run(...)`
# trampoline-телах (каждое тело — минимум 1 CC). Это арифметика surface area, а не
# code smell. Per-method CA1502 ≤30 продолжает ловить реальную сложность.
[**/Throne.Api/**/*Controller.cs]
dotnet_diagnostic.CA1502.severity = none

# intent:aa5b39b430c54685a08f475d3be167b9 (Phase 4 quality cleanup).
# Mongo Infrastructure is an adapter layer between strongly-typed Builders<T> /
# BsonElement POCOs and a polymorphic document store. CA1502 (cyclomatic
# per-type ≤10) and CA1506 (coupling per type ≤120) are structurally too tight
# here for two structural reasons:
#   * POCO documents fan out 8–15 [BsonElement] properties, each of which
#     contributes to type-level cyclomatic via the analyzer's accessor walk.
#   * Repository adapters compose filter/sort/pagination chains with
#     Builders<TDoc>.Filter/Update — each branch adds CC, and the typed
#     wrappers inflate coupling. Splitting helpers out hides the adapter
#     intent.
# Same architectural precedent as **/Throne.Api/**/*Controller.cs above.
# Per-method CA1502 ≤30 and CA1506 method-level (≤50) continue to catch real
# complexity; the type-level summing is what is being relaxed.
[**/Throne.Infrastructure/Mongo/**.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none

# intent:aa5b39b430c54685a08f475d3be167b9: Imaging worker streams images and
# dispatches by codec; Manifest provider parses YAML skill bundles with a
# multi-arm format-version dispatch. Same Builders / dispatch precedent — the
# per-type cyclomatic budget is structurally over 10 and there is no useful
# split (one type = one external integration).
[**/Throne.Infrastructure/Imaging/**.cs]
dotnet_diagnostic.CA1502.severity = none

[**/Throne.Infrastructure/Manifest/**.cs]
dotnet_diagnostic.CA1502.severity = none

# intent:2a8ecca5b990437da9448c73974d27ee — `GitHubCliProvider` is the IGitProvider
# facade that fans out to per-aspect helpers (search / clone / sync / auth / PR
# snapshot / PR comments / branches / PR list). Each interface method is a
# one-line `=> helper.Method(...)` trampoline; type-level cyclomatic is just the
# arithmetic of the surface area, not real complexity. Same precedent as
# **/Throne.Api/**/*Controller.cs above (NSwag-generated controllers with many
# trampoline routes). Per-method CA1502 ≤30 continues to catch real complexity
# inside each helper.
[**/Throne.Infrastructure/Git/GitHubCli/GitHubCliProvider.cs]
dotnet_diagnostic.CA1502.severity = none

# intent:aa5b39b430c54685a08f475d3be167b9: tests/** with CA1502/CA1506
# suppressions are structural test designs, not god-class symptoms:
#
#   * NetArchTest / Mono.Cecil / reflection rules in Throne.Architecture.Tests
#     enumerate every type in the solution; per-test loops + assertions push
#     type-level CC well past 10 by design (one rule == one type).
#   * WebApplicationFactory-backed endpoint/tool tests in Throne.Api.Tests
#     embed seeding helpers + per-test orchestration inside the same class so
#     fixtures stay co-located with cases.
#   * Handler tests in Throne.Application.Tests assemble realistic IoC graphs
#     per test (mocks, in-mem repos, clocks, validators); same coupling tax.
#   * Infrastructure repo tests in Throne.Infrastructure.Tests wrap Mongo
#     fixtures + Builders<T> assertion chains around per-method coverage.
#
# Splitting any of these hides the test intent; the existing solo CA1502
# per-method ≤30 and CA1506 method-level ≤50 continue to catch genuine
# accidental complexity introduced by a single test method.
# intent:6e96cd2226e843ddbfe08f2502d49cbe — MCP wire-policy renderers
# (ADR-0003 §8.1) собирают plain-text Content[] + compact StructuredContent refs
# по каждому tool-результату. Type-level cyclomatic суммируется по Append*
# хелперам + null-/pattern-checks (опциональный applied_text, reject_comment,
# decided_at, list-iteration). Каждая ветка маппится 1:1 на опциональное поле
# wire-формата — разнесение renderer'а по разным файлам прячет wire-policy
# intent. Тот же архитектурный прецедент, что и `**/Throne.Api/**/*Controller.cs`
# выше. Per-method CA1502 ≤30 продолжает ловить реальную сложность.
[**/Throne.Api/Mcp/Tools/*Renderer.cs]
dotnet_diagnostic.CA1502.severity = none

[**/Throne.Architecture.Tests/**RulesTests.cs]
dotnet_diagnostic.CA1502.severity = none

[**/Throne.Api.Tests/**Tests.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none

[**/Throne.Application.Tests/**Tests.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none

[**/Throne.Infrastructure.Tests/**Tests.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none

[**/Throne.Domain.Tests/**Tests.cs]
dotnet_diagnostic.CA1502.severity = none

