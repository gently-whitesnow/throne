root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{json,yml,yaml,md,sh}]
indent_size = 2

[*.cs]
# Code style
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning

# Code metrics analyzers (thresholds in apps/api/CodeMetricsConfig.txt).
# With TreatWarningsAsErrors=true these become blocking on backend-build.
dotnet_diagnostic.CA1501.severity = warning
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1505.severity = warning
dotnet_diagnostic.CA1506.severity = warning

# Nullability
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning

# Naming - instance private fields _camelCase (constants stay PascalCase)
dotnet_naming_rule.private_instance_fields_underscore.severity = warning
dotnet_naming_rule.private_instance_fields_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_instance_fields.required_modifiers =
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.private_const_fields_pascal.severity = suggestion
dotnet_naming_rule.private_const_fields_pascal.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_pascal.style = pascal_case_style
dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_static_readonly_pascal.severity = suggestion
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_case_style
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static,readonly

# Tests use snake_case method names (idiomatic xUnit) — disable CA1707
[**/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# Pre-existing CA1502 violations on aggregate roots / domain types.
# TODO(intent:84be552145af4ca3bdab3584aa61d46e): декомпозировать и снять suppress.
# До этого момента per-type cyclomatic threshold для перечисленных файлов выключен,
# глобальный порог в CodeMetricsConfig.txt остаётся CA1502(Type): 10.
[src/Throne.Domain/Instructions/Instruction.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Domain/Intents/Intent.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Domain/Intents/IntentTextSearch.cs]
dotnet_diagnostic.CA1502.severity = none

# Fractional indexing algorithm: branching is the algorithm. Splitting hides intent.
[src/Throne.Domain/Intents/FractionalIndex.cs]
dotnet_diagnostic.CA1502.severity = none

# Intent aggregate is wide: list/get/create/edit/move/tag/status/delete are all natural
# read+write operations. Splitting into role interfaces would shred a single aggregate.
[src/Throne.Application/Ports/IIntentRepository.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Domain/Tags/Tag.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Domain.Tests/Intents/FractionalIndexTests.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Imaging/IntentAttachmentCompressionWorker.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Manifest/YamlFileSkillManifestProvider.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/Documents/InstructionDocument.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/Documents/IntentAttachmentDocument.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/Documents/IntentDocument.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/Documents/IntentStatusChangeDocument.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/Documents/McpCallLogDocument.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/Documents/TextVersionDocument.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/McpArgumentSummaries.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/MongoInstructionRepository.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none

[src/Throne.Infrastructure/Mongo/MongoIntentAttachmentRepository.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/MongoIntentRepository.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none

# ADR-0018: Mongo POCO adapter; CA1502 type-level threshold (10) is structurally
# too tight for the property fan-out — same precedent as IntentDocument et al.
[src/Throne.Infrastructure/Mongo/Documents/IntentLinkDocument.cs]
dotnet_diagnostic.CA1502.severity = none

# ADR-0019: Mongo POCO adapter for intent_events; CA1502 type-level threshold (10)
# is structurally too tight for the property fan-out — same precedent as IntentDocument.
[src/Throne.Infrastructure/Mongo/Documents/IntentEventDocument.cs]
dotnet_diagnostic.CA1502.severity = none

# ADR-0019: Mongo repository adapter for intent_events; complexity inflated by
# Builders<T> expression chains (same precedent as MongoIntentRepository).
[src/Throne.Infrastructure/Mongo/MongoIntentEventRepository.cs]
dotnet_diagnostic.CA1502.severity = none

# ADR-0019: One-shot migration job. Type-level cyclomatic budget is inflated by
# the per-document upsert + duplicate-key swallow + LoggerMessage source-gen partial.
# Splitting the host into multiple types loses the «runs once on startup» contract.
[src/Throne.Infrastructure/Mongo/MongoIntentEventsMigration.cs]
dotnet_diagnostic.CA1502.severity = none

# MongoIndexInitializer fans out indexes for ~10 collections plus the ADR-0021
# retired-collection drop step; the per-type cyclomatic budget is structurally
# unavoidable for a centralised startup hosted-service.
[src/Throne.Infrastructure/Mongo/MongoIndexInitializer.cs]
dotnet_diagnostic.CA1502.severity = none

# ADR-0018: Mongo repository adapter; CA1502 type-level inflated by Builders<T>
# expression chains (same precedent as MongoIntentRepository / MongoTagRepository).
[src/Throne.Infrastructure/Mongo/MongoIntentLinkRepository.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none

[src/Throne.Infrastructure/Mongo/MongoIntentTrainingRepository.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/MongoMcpCallLogSink.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/MongoPersonalAccessTokenRepository.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/MongoTagRepository.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Application.Tests/Intents/CreateIntentHandlerTests.cs]
dotnet_diagnostic.CA1506.severity = none

[src/Throne.Api/Auth/AuthOptions.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Api/Auth/PersonalAccessTokenAuthMiddleware.cs]
dotnet_diagnostic.CA1502.severity = none

# IntentsController: 18 routes за одним NSwag-generated `IntentsControllerBase`.
# Refactor pass intent:7e9e1a282eaa4853b4efdf3269d76c71 вынес error-mapper, DTO-mapper,
# TextVersion mapper, и сократил inline helpers, но сам тип всё равно за порогом
# CA1502(Type)=10: каждый action добавляет try/catch/await/foreach (~3 cyclomatic),
# а 18 routes структурно дают ~50. Дальнейшее снижение требует split на несколько
# контроллеров (отдельной OpenAPI-секцией), что вне рамок этого pass.
[src/Throne.Api/Intents/IntentsController.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Api/Mcp/AuditingMcpServerTool.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Api/Mcp/Tools/IntentAttachmentTools.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Infrastructure.Tests/Mongo/MongoIntentRepositoryTests.cs]
dotnet_diagnostic.CA1506.severity = none

[tests/Throne.Infrastructure.Tests/Mongo/TransactionRollbackTests.cs]
dotnet_diagnostic.CA1506.severity = none

[tests/Throne.Api.Tests/Auth/PersonalAccessTokenEndpointTests.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Api.Tests/Intents/ListIntentsEndpointTests.cs]
dotnet_diagnostic.CA1502.severity = none

# Integration test class wraps WebApplicationFactory + Mongo seeding helpers;
# CA1502 measures the sum across all helpers and per-test orchestration which
# pushes a single class above the per-type budget. Splitting helpers out hides
# the test setup intent. Same precedent as the auth + intents endpoint tests above.
[tests/Throne.Api.Tests/Intents/UploadIntentAttachmentEndpointTests.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Api.Tests/Mcp/AuditingMcpServerToolTests.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Api.Tests/Mcp/IntentAttachmentToolsTests.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Architecture.Tests/LayerDependencyRulesTests.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Architecture.Tests/McpBoundMethodParameterRulesTests.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Architecture.Tests/McpToolRegistrationRulesTests.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Architecture.Tests/OwnerUserIdRulesTests.cs]
dotnet_diagnostic.CA1502.severity = none

# RealtimeDomainEventHandler is the single switch over all domain events; its
# fan-out grows by construction every time a new realtime event is added (this
# file is the «4-way coverage» pivot from the realtime gate). The CA1506
# threshold is structurally unavoidable here — same precedent as other
# centralised dispatch/factory types above.
[src/Throne.Api/Realtime/RealtimeDomainEventHandler.cs]
dotnet_diagnostic.CA1506.severity = none

# InstructionPatch aggregate (ADR-0021 supersedes ADR-0011). Same precedent as
# InsightCard / Intent above: the aggregate exposes ≥14 properties (identity +
# state + EvidenceCardIds + PatchText + Rationale) and a state-machine via the
# transition helper, and the Mongo repo wraps Builders<T> chains for the
# owner-scoped list/apply/reject paths. Static factory + transition helpers and
# the controller fall under the same Builders / dispatch precedents.
[src/Throne.Domain/Instructions/InstructionPatch.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Domain/Instructions/InstructionPatchGuards.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Domain/Instructions/InstructionPatchBudgets.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Domain/Instructions/InstructionPatchTransitions.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Domain/Instructions/InstructionPatchFactory.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/Documents/InstructionPatchDocument.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Infrastructure/Mongo/MongoInstructionPatchRepository.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none

[src/Throne.Api/InstructionPatches/InstructionPatchDtoMapper.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Api/Mcp/Tools/InstructionPatchTools.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Application/InstructionPatches/ApplyInstructionPatchHandler.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Application/InstructionPatches/GetInstructionPatchHandler.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Application/InstructionPatches/ProposeInstructionPatchHandler.cs]
dotnet_diagnostic.CA1502.severity = none

[src/Throne.Application/InstructionPatches/RejectInstructionPatchHandler.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Domain.Tests/Instructions/InstructionPatchTests.cs]
dotnet_diagnostic.CA1502.severity = none

[tests/Throne.Infrastructure.Tests/Mongo/MongoInstructionPatchRepositoryTests.cs]
dotnet_diagnostic.CA1502.severity = none

# ADR-0022: DreamSession Mongo POCO. CA1502 type-level threshold (10) is
# structurally too tight for the property fan-out — same precedent as
# InstructionPatchDocument / IntentDocument et al.
[src/Throne.Infrastructure/Mongo/Documents/DreamSessionDocument.cs]
dotnet_diagnostic.CA1502.severity = none

