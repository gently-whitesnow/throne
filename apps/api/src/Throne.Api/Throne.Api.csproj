<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Throne.Application\Throne.Application.csproj" />
    <ProjectReference Include="..\Throne.Infrastructure\Throne.Infrastructure.csproj" />
    <ProjectReference Include="..\Throne.Intents.Contracts\Throne.Intents.Contracts.csproj" />
    <ProjectReference Include="..\Throne.Realtime.Contracts\Throne.Realtime.Contracts.csproj" />
    <ProjectReference Include="..\Throne.Tags.Contracts\Throne.Tags.Contracts.csproj" />
    <ProjectReference Include="..\Throne.PromptPartPatches.Contracts\Throne.PromptPartPatches.Contracts.csproj" />
    <ProjectReference Include="..\Throne.Dreams.Contracts\Throne.Dreams.Contracts.csproj" />
    <ProjectReference Include="..\Throne.Repositories.Contracts\Throne.Repositories.Contracts.csproj" />
    <ProjectReference Include="..\Throne.Settings.Contracts\Throne.Settings.Contracts.csproj" />
    <ProjectReference Include="..\Throne.Capabilities.Contracts\Throne.Capabilities.Contracts.csproj" />
    <ProjectReference Include="..\Throne.Terminal.Contracts\Throne.Terminal.Contracts.csproj" />
    <ProjectReference Include="..\Throne.Vscode.Contracts\Throne.Vscode.Contracts.csproj" />
    <ProjectReference Include="..\Throne.PromptParts.Contracts\Throne.PromptParts.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Skill manifest is the runtime source of truth (see ADR-0014). It must travel
      with the published binary, otherwise the API fails to boot in environments
      where the repo tree is not available next to /app (Docker, CI artefacts).
      Link= preserves the directory layout so the provider's existing path lookup
      under AppContext.BaseDirectory keeps working unchanged.
    -->
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\..\specs\manifest\throne-skills.yaml"
             Link="specs/manifest/throne-skills.yaml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\..\skills\**\*"
             Link="skills/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\..\bin\throne-*"
             Link="bin/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
