<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Throne.Mcp.Stdio</AssemblyName>
    <RootNamespace>Throne.Mcp.Stdio</RootNamespace>
  </PropertyGroup>

  <!--
    Thin STDIO→HTTP MCP proxy for Throne.Api. No Application/Infrastructure/Mongo
    dependencies on purpose: this process must not be able to mutate state directly
    (otherwise domain events fire in this process and the web UI never sees them).
    See ADR-0009.
  -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
