<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Throne.Mcp.Stdio</AssemblyName>
    <RootNamespace>Throne.Mcp.Stdio</RootNamespace>
  </PropertyGroup>

  <!--
    Thin STDIO→HTTP MCP proxy for Throne.Api. No Application/Infrastructure/Mongo
    dependencies on purpose: this process must not be able to mutate state directly
    (otherwise domain events fire in this process and the web UI never sees them).
    See ADR-0009.

    Packaged as a global .NET tool (PackAsTool) so end-users wire up MCP clients with
    `command: "throne-mcp-stdio"` instead of a checkout-local `dotnet run`.
    Tool command + package metadata are kept here; version is set on `dotnet pack`
    from the release tag via -p:PackageVersion.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>throne-mcp-stdio</ToolCommandName>
    <PackageId>Throne.Mcp.Stdio</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Authors>gently-whitesnow</Authors>
    <Description>STDIO→HTTP MCP proxy for Throne.Api. Lets STDIO-only MCP clients (Claude Desktop, Claude Code, Cursor, Codex) talk to a locally running Throne instance.</Description>
    <PackageTags>throne;mcp;model-context-protocol;stdio</PackageTags>
    <RepositoryUrl>https://github.com/gently-whitesnow/throne</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/gently-whitesnow/throne</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
