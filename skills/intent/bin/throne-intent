#!/usr/bin/env bash
set -euo pipefail

INTENT_ID="${THRONE_INTENT_ID:-}"
API_BASE="${THRONE_API_BASE:-http://localhost:5008}"
API_BASE="${API_BASE%/}"

usage() {
  cat <<'USAGE'
Usage:
  throne-intent get
  throne-intent replace-text --old-file OLD --new-file NEW
  throne-intent set-title (--title TEXT | --clear)
  throne-intent create --text-file TEXT [--title TEXT] [--tag TAG]... [--id-only]
  throne-intent link TO_ID [--blocking true|false] [--rationale-file FILE]
USAGE
}

die() {
  echo "throne-intent: $*" >&2
  exit 64
}

require_intent() {
  [[ -n "${INTENT_ID}" ]] || die "THRONE_INTENT_ID is required"
}

require_file() {
  [[ -f "$1" ]] || die "file not found: $1"
}

http_request() {
  local method="$1"
  local path="$2"
  local tmp status url
  url="${API_BASE}${path}"
  tmp="$(mktemp)"
  if [[ $# -ge 3 ]]; then
    if ! status="$(printf '%s' "$3" | curl -sS -o "${tmp}" -w '%{http_code}' \
      -X "${method}" "${url}" -H 'Content-Type: application/json' --data-binary @-)"; then
      rm -f "${tmp}"
      echo "throne-intent: curl failed for ${method} ${path}" >&2
      exit 1
    fi
  else
    if ! status="$(curl -sS -o "${tmp}" -w '%{http_code}' -X "${method}" "${url}")"; then
      rm -f "${tmp}"
      echo "throne-intent: curl failed for ${method} ${path}" >&2
      exit 1
    fi
  fi
  HTTP_STATUS="${status}"
  HTTP_BODY="$(cat "${tmp}")"
  rm -f "${tmp}"
}

print_or_fail() {
  local action="$1"
  if [[ "${HTTP_STATUS}" =~ ^2 ]]; then
    printf '%s\n' "${HTTP_BODY}"
    return
  fi
  printf '%s\n' "${HTTP_BODY}" >&2
  echo "throne-intent: ${action} failed with HTTP ${HTTP_STATUS}" >&2
  exit 1
}

json_field() {
  python3 -c 'import json, sys
value = json.load(sys.stdin)
for part in sys.argv[1].split("."):
    value = value[part]
print(value)' "$1"
}

replace_payload() {
  python3 - "$1" "$2" "$3" <<'PY'
import json, pathlib, sys
payload = {
    "expected_version": int(sys.argv[1]),
    "old_text": pathlib.Path(sys.argv[2]).read_text(),
    "new_text": pathlib.Path(sys.argv[3]).read_text(),
}
print(json.dumps(payload, ensure_ascii=False))
PY
}

create_payload() {
  # argv: TEXT_FILE TITLE TAG...  (TITLE empty string means "untitled")
  python3 - "$@" <<'PY'
import json, pathlib, sys
payload = {"text": pathlib.Path(sys.argv[1]).read_text()}
title = sys.argv[2]
if title:
    payload["title"] = title
tags = sys.argv[3:]
if tags:
    payload["tag_names"] = tags
print(json.dumps(payload, ensure_ascii=False))
PY
}

set_title_payload() {
  # argv: VERSION MODE(set|clear) TITLE
  python3 - "$1" "$2" "${3:-}" <<'PY'
import json, sys
payload = {"expected_version": int(sys.argv[1])}
payload["title"] = None if sys.argv[2] == "clear" else sys.argv[3]
print(json.dumps(payload, ensure_ascii=False))
PY
}

link_payload() {
  python3 - "$@" <<'PY'
import json, pathlib, sys
rationale_file = sys.argv[3]
payload = {"to_id": sys.argv[1], "blocking": sys.argv[2] == "true"}
if rationale_file:
    payload["rationale"] = pathlib.Path(rationale_file).read_text()
print(json.dumps(payload, ensure_ascii=False))
PY
}

cmd_get() {
  require_intent
  http_request GET "/api/v1/intents/${INTENT_ID}"
  print_or_fail "get"
}

cmd_replace_text() {
  require_intent
  local old_file="" new_file="" version payload
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --old-file) old_file="${2:-}"; shift 2 ;;
      --new-file) new_file="${2:-}"; shift 2 ;;
      --help) usage; exit 0 ;;
      *) die "unknown replace-text argument: $1" ;;
    esac
  done
  [[ -n "${old_file}" ]] || die "replace-text requires --old-file"
  [[ -n "${new_file}" ]] || die "replace-text requires --new-file"
  require_file "${old_file}"
  require_file "${new_file}"

  http_request GET "/api/v1/intents/${INTENT_ID}"
  print_or_fail "get before replace-text" >/dev/null
  version="$(printf '%s' "${HTTP_BODY}" | json_field current_version)"
  payload="$(replace_payload "${version}" "${old_file}" "${new_file}")"
  http_request POST "/api/v1/intents/${INTENT_ID}/replace-text" "${payload}"
  if [[ "${HTTP_STATUS}" == "409" ]]; then
    echo "throne-intent: replace-text lost an optimistic-concurrency race." >&2
    echo "throne-intent: run 'throne-intent get', refresh fragments, and retry." >&2
    exit 75
  fi
  print_or_fail "replace-text"
}

cmd_set_title() {
  require_intent
  local title="" clear=false title_set=false version payload
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) title="${2:-}"; title_set=true; shift 2 ;;
      --clear) clear=true; shift ;;
      --help) usage; exit 0 ;;
      *) die "unknown set-title argument: $1" ;;
    esac
  done
  if [[ "${clear}" == true && "${title_set}" == true ]]; then
    die "set-title takes either --title or --clear, not both"
  fi
  [[ "${clear}" == true || "${title_set}" == true ]] || die "set-title requires --title TEXT or --clear"

  http_request GET "/api/v1/intents/${INTENT_ID}"
  print_or_fail "get before set-title" >/dev/null
  version="$(printf '%s' "${HTTP_BODY}" | json_field current_version)"
  if [[ "${clear}" == true ]]; then
    payload="$(set_title_payload "${version}" clear)"
  else
    payload="$(set_title_payload "${version}" set "${title}")"
  fi
  http_request PUT "/api/v1/intents/${INTENT_ID}/title" "${payload}"
  if [[ "${HTTP_STATUS}" == "409" ]]; then
    echo "throne-intent: set-title lost an optimistic-concurrency race." >&2
    echo "throne-intent: run 'throne-intent get' and retry." >&2
    exit 75
  fi
  if [[ "${HTTP_STATUS}" == "422" ]]; then
    echo "throne-intent: set-title rejected — a card-linked intent must keep a non-empty title." >&2
    printf '%s\n' "${HTTP_BODY}" >&2
    exit 65
  fi
  print_or_fail "set-title"
}

cmd_create() {
  local text_file="" title="" id_only=false
  local tags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --text-file) text_file="${2:-}"; shift 2 ;;
      --title) title="${2:-}"; shift 2 ;;
      --tag) tags+=("${2:-}"); shift 2 ;;
      --id-only) id_only=true; shift ;;
      --help) usage; exit 0 ;;
      *) die "unknown create argument: $1" ;;
    esac
  done
  [[ -n "${text_file}" ]] || die "create requires --text-file"
  require_file "${text_file}"

  http_request POST "/api/v1/intents" "$(create_payload "${text_file}" "${title}" ${tags[@]+"${tags[@]}"})"
  if [[ "${HTTP_STATUS}" =~ ^2 ]]; then
    if [[ "${id_only}" == true ]]; then
      printf '%s' "${HTTP_BODY}" | json_field id
    else
      printf '%s\n' "${HTTP_BODY}"
    fi
    return
  fi
  print_or_fail "create"
}

cmd_link() {
  require_intent
  local to_id="${1:-}" blocking=false rationale_file=""
  [[ -n "${to_id}" ]] || die "link requires TO_ID"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --blocking) blocking="${2:-}"; shift 2 ;;
      --rationale-file) rationale_file="${2:-}"; shift 2 ;;
      --help) usage; exit 0 ;;
      *) die "unknown link argument: $1" ;;
    esac
  done
  [[ "${blocking}" == "true" || "${blocking}" == "false" ]] || die "--blocking must be true or false"
  if [[ -n "${rationale_file}" ]]; then
    require_file "${rationale_file}"
  fi

  http_request POST "/api/v1/intents/${INTENT_ID}/links" \
    "$(link_payload "${to_id}" "${blocking}" "${rationale_file}")"
  print_or_fail "link"
}

case "${1:-}" in
  get) shift; [[ $# -eq 0 ]] || die "get takes no arguments"; cmd_get ;;
  replace-text) shift; cmd_replace_text "$@" ;;
  set-title) shift; cmd_set_title "$@" ;;
  create) shift; cmd_create "$@" ;;
  link) shift; cmd_link "$@" ;;
  --help|-h|"") usage ;;
  *) die "unknown subcommand: $1" ;;
esac
